// 16x16 INT8 tiled matmul using systolic array accumulate mode.
// A = B = all-1s (16x16). Every 4x4 tile row = 0x01010101.
//
// One 4x4 tile K-pass: C[i][j] = sum(1*1, 4 terms) = 4.
// Four K-passes with accumulate mode:  C[i][j] = 4+4+4+4 = 16.
//
// Expected result: C_INT32[0][0] = 16 in x11 after halt.
// 16 = proof that all four K-passes accumulated correctly.
// (One pass alone gives 4 — only correct accumulate-mode chaining yields 16.)
//
// Program structure:
//   x10 = 0xFFFD0000  systolic base
//   x11 = 0x01010101  packed all-1s tile row
//   x12 = 1           CTRL_START_CLEAR (clears c_acc)
//   x13 = 3           CTRL_START_ACCUM (preserves c_acc)
//   x14 = 16          outer loop counter (16 output tiles = 4x4 grid of 4x4 tiles)
//
// Per tile: 4 K-passes (bk=0 clears, bk=1..3 accumulate).
// After 16 tiles: read C_INT32[0][0] from offset 0x80.
//
// Instruction encodings verified by hand:
//   sw x11, imm(x10) with imm=0x10/14/18/1C: 0x00B528/A/C/E23
//   sw x11, imm(x10) with imm=0x20/24/28/2C: 0x02B520/2/4/623
//   sw x12, 0x00(x10) = 0x00C52023   CTRL=1 (clear+start)
//   sw x13, 0x00(x10) = 0x00D52023   CTRL=3 (accumulate+start)
//   lw x15, 0x04(x10) = 0x00452783   read STATUS
//   beq x15,x0,-4    = 0xFE078EE3    poll until done

// PC 0x00: lui  x10, 0xFFFD0    → x10 = 0xFFFD0000 (systolic base)
FFFD0537
// PC 0x04: lui  x11, 0x01010    → x11 = 0x01010000
010105B7
// PC 0x08: addi x11, x11, 0x101 → x11 = 0x01010101
10158593
// PC 0x0C: addi x12, x0, 1      → x12 = 1 (CTRL start+clear)
00100613
// PC 0x10: addi x13, x0, 3      → x13 = 3 (CTRL start+accumulate)
00300693
// PC 0x14: addi x14, x0, 16     → x14 = 16 (tile loop counter)
01000713

// ── tile_loop (PC 0x18) ──────────────────────────────────────────────────────
// K-pass 0: CTRL=1 (clear c_acc before first tile-K pass)

// PC 0x18: sw x11, 0x10(x10)   A_ROW0 = all-1s
00B52823
// PC 0x1C: sw x11, 0x14(x10)   A_ROW1
00B52A23
// PC 0x20: sw x11, 0x18(x10)   A_ROW2
00B52C23
// PC 0x24: sw x11, 0x1C(x10)   A_ROW3
00B52E23
// PC 0x28: sw x11, 0x20(x10)   B_ROW0 (B^T col, all-1s)
02B52023
// PC 0x2C: sw x11, 0x24(x10)   B_ROW1
02B52223
// PC 0x30: sw x11, 0x28(x10)   B_ROW2
02B52423
// PC 0x34: sw x11, 0x2C(x10)   B_ROW3
02B52623
// PC 0x38: sw x12, 0x00(x10)   CTRL = 1 (start + clear c_acc)
00C52023
// PC 0x3C: lw x15, 0x04(x10)   read STATUS  ← wait0
00452783
// PC 0x40: beq x15, x0, -4     loop if not done (STATUS==0)
FE078EE3

// K-pass 1: CTRL=3 (accumulate — preserve c_acc from pass 0)

// PC 0x44: sw x11, 0x10(x10)
00B52823
// PC 0x48: sw x11, 0x14(x10)
00B52A23
// PC 0x4C: sw x11, 0x18(x10)
00B52C23
// PC 0x50: sw x11, 0x1C(x10)
00B52E23
// PC 0x54: sw x11, 0x20(x10)
02B52023
// PC 0x58: sw x11, 0x24(x10)
02B52223
// PC 0x5C: sw x11, 0x28(x10)
02B52423
// PC 0x60: sw x11, 0x2C(x10)
02B52623
// PC 0x64: sw x13, 0x00(x10)   CTRL = 3 (start + accumulate)
00D52023
// PC 0x68: lw x15, 0x04(x10)   ← wait1
00452783
// PC 0x6C: beq x15, x0, -4
FE078EE3

// K-pass 2: CTRL=3 (accumulate)

// PC 0x70: sw x11, 0x10(x10)
00B52823
// PC 0x74: sw x11, 0x14(x10)
00B52A23
// PC 0x78: sw x11, 0x18(x10)
00B52C23
// PC 0x7C: sw x11, 0x1C(x10)
00B52E23
// PC 0x80: sw x11, 0x20(x10)
02B52023
// PC 0x84: sw x11, 0x24(x10)
02B52223
// PC 0x88: sw x11, 0x28(x10)
02B52423
// PC 0x8C: sw x11, 0x2C(x10)
02B52623
// PC 0x90: sw x13, 0x00(x10)   CTRL = 3
00D52023
// PC 0x94: lw x15, 0x04(x10)   ← wait2
00452783
// PC 0x98: beq x15, x0, -4
FE078EE3

// K-pass 3: CTRL=3 (accumulate — final pass for this output tile)

// PC 0x9C: sw x11, 0x10(x10)
00B52823
// PC 0xA0: sw x11, 0x14(x10)
00B52A23
// PC 0xA4: sw x11, 0x18(x10)
00B52C23
// PC 0xA8: sw x11, 0x1C(x10)
00B52E23
// PC 0xAC: sw x11, 0x20(x10)
02B52023
// PC 0xB0: sw x11, 0x24(x10)
02B52223
// PC 0xB4: sw x11, 0x28(x10)
02B52423
// PC 0xB8: sw x11, 0x2C(x10)
02B52623
// PC 0xBC: sw x13, 0x00(x10)   CTRL = 3
00D52023
// PC 0xC0: lw x15, 0x04(x10)   ← wait3
00452783
// PC 0xC4: beq x15, x0, -4
FE078EE3

// ── loop end ─────────────────────────────────────────────────────────────────
// PC 0xC8: addi x14, x14, -1   decrement tile counter
FFF70713
// PC 0xCC: bne x14, x0, -180   branch back to tile_loop at 0x18
// offset = 0x18 - 0xCC = -180 = 0b1_1111_0100_1100 (13-bit)
F40716E3

// ── post-loop ─────────────────────────────────────────────────────────────────
// PC 0xD0: lw x11, 0x80(x10)   read C_INT32[0][0] → x11 = 16
08052583
// PC 0xD4: jal x0, 0            halt
0000006F

// padding to 256 words
00000000
