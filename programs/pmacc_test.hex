// PMACC pipeline integration test
// Tests all forwarding paths for the PMACC accumulator port.
//
// PDOT([1,2,3,4],[5,6,7,8]) = 1*5+2*6+3*7+4*8 = 5+12+21+32 = 70
//
// Results are kept in registers so the testbench can probe RF directly,
// avoiding dcache write-back timing issues.
//
// x11 = 70   test 1: acc from RF (no forwarding, 4 NOPs before PMACC)
// x12 = 210  test 2: EX/MEM forwarding (3 back-to-back PMACCs)
// x13 = 140  test 3: MEM/WB forwarding (1 NOP between PMACCs)
// x14 = 140  test 4: load-use stall on acc port (LW then PMACC)
//
// Encoding:
//   pmacc x5, x1, x2 = 0x0020B28B
//   opcode=0001011 funct3=011 rs1=x1 rs2=x2 rd=x5
//
// PC+0x00: lui  x1, 0x04030  → x1 = 0x04030000
040300B7
// PC+0x04: addi x1, x1, 0x201 → x1 = 0x04030201 ([1,2,3,4] lo→hi)
20108093
// PC+0x08: lui  x2, 0x08070  → x2 = 0x08070000
08070137
// PC+0x0C: addi x2, x2, 0x605 → x2 = 0x08070605 ([5,6,7,8] lo→hi)
60510113
//
// Test 1: acc from register file — x5 set to 0, then 4 NOPs, then PMACC
// No forwarding needed: x5=0 is settled in RF before PMACC reaches ID.
// PC+0x10: addi x5, x0, 0
00000293
// PC+0x14: nop
00000013
// PC+0x18: nop
00000013
// PC+0x1C: nop
00000013
// PC+0x20: nop
00000013
// PC+0x24: pmacc x5, x1, x2  → x5 = 0+70 = 70
0020B28B
// PC+0x28: addi x11, x5, 0   → x11 = 70 (saved)
00028593
//
// Test 2: EX/MEM forwarding — 3 back-to-back PMACCs on x5
// Each PMACC reads the previous PMACC's result from EX/MEM stage.
// PC+0x2C: addi x5, x0, 0
00000293
// PC+0x30: pmacc x5, x1, x2  → x5 = 70
0020B28B
// PC+0x34: pmacc x5, x1, x2  → x5 = 140 (EX/MEM forward)
0020B28B
// PC+0x38: pmacc x5, x1, x2  → x5 = 210 (EX/MEM forward)
0020B28B
// PC+0x3C: addi x12, x5, 0   → x12 = 210 (saved)
00028613
//
// Test 3: MEM/WB forwarding — 1 NOP between PMACCs
// First PMACC result is in MEM/WB stage when second PMACC is in EX.
// PC+0x40: addi x5, x0, 0
00000293
// PC+0x44: pmacc x5, x1, x2  → x5 = 70
0020B28B
// PC+0x48: nop
00000013
// PC+0x4C: pmacc x5, x1, x2  → x5 = 140 (MEM/WB forward)
0020B28B
// PC+0x50: addi x13, x5, 0   → x13 = 140 (saved)
00028693
//
// Test 4: load-use stall on acc port
// LW x5 followed immediately by PMACC reading x5 as accumulator.
// Hazard unit detects id_is_pmacc && ex_rd_addr==id_rd_addr and inserts stall.
// PC+0x54: lui  x10, 1       → x10 = 0x1000 (data scratch address)
00001537
// PC+0x58: addi x3, x0, 70  → x3 = 70
04600193
// PC+0x5C: sw   x3, 0(x10)  → mem[0x1000] = 70
00352023
// PC+0x60: lw   x5, 0(x10)  → x5 = 70 (stall on next PMACC's acc read)
00052283
// PC+0x64: pmacc x5, x1, x2  → x5 = 70+70=140 (stall inserted for load-use on acc)
0020B28B
// PC+0x68: addi x14, x5, 0  → x14 = 140 (saved)
00028713
//
// Halt: jal x0, 0 (infinite loop)
// PC+0x6C: 0000006F
0000006F
// padding to 256 words
00000000
