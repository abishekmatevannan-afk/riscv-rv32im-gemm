// PSRA + PRELU pipeline integration test
// Tests rs1 forwarding paths for both instructions.
//
// Results in registers (no memory access, avoids dcache write-back timing):
//   x11 = 0xC0000000  test 1: PSRA, acc from RF (4 NOPs, no forwarding)
//   x12 = 0xFF3F00FF  test 2: PSRA, EX/MEM forward on rs1
//   x13 = 0x00000001  test 3: PRELU, MEM/WB forward on rs1 (1 NOP)
//   x14 = 0x007F0000  test 4: PRELU, EX/MEM forward on rs1
//
// Data used:
//   0x80000001 bytes (lo→hi): [0x01=+1, 0x00=0, 0x00=0, 0x80=-128]
//   0xFF7F00FF bytes (lo→hi): [0xFF=-1, 0x00=0, 0x7F=+127, 0xFF=-1]
//
// PSRA(0x80000001, shamt=1): [0>>1=0, 0>>1=0, 0>>1=0, -128>>1=-64=C0] = 0xC0000000
// PSRA(0xFF7F00FF, shamt=1): [-1>>1=-1=FF, 0>>1=0, 127>>1=63=3F, -1>>1=-1=FF] = 0xFF3F00FF
// PRELU(0x80000001):         [max(0,1)=1, max(0,0)=0, max(0,0)=0, max(0,-128)=0] = 0x00000001
// PRELU(0xFF7F00FF):         [max(0,-1)=0, max(0,0)=0, max(0,127)=7F, max(0,-1)=0] = 0x007F0000
//
// Encodings:
//   PSRA x5, x1, 1  = 0x2200C28B  (funct7=0010001, rs2=x0, rs1=x1, f3=100, rd=x5)
//   PRELU x5, x1    = 0x4000D28B  (funct7=0100000, rs2=x0, rs1=x1, f3=101, rd=x5)
//
// PC+0x00: lui  x1, 0x80000  → x1 = 0x80000000
800000B7
// PC+0x04: addi x1, x1, 1   → x1 = 0x80000001
00108093
//
// Test 1: PSRA from register file — 4 NOPs, no forwarding needed
// PC+0x08: nop
00000013
// PC+0x0C: nop
00000013
// PC+0x10: nop
00000013
// PC+0x14: nop
00000013
// PC+0x18: PSRA x5, x1, 1  → x5 = 0xC0000000
2200C28B
// PC+0x1C: addi x11, x5, 0 → x11 = 0xC0000000 (saved)
00028593
//
// Test 2: PSRA — EX/MEM forwarding (addi immediately before PSRA)
// PC+0x20: lui  x1, 0xFF7F0  → x1 = 0xFF7F0000
FF7F00B7
// PC+0x24: addi x1, x1, 0xFF → x1 = 0xFF7F00FF  ← forwarded via EX/MEM
0FF08093
// PC+0x28: PSRA x5, x1, 1   → x5 = 0xFF3F00FF (EX/MEM forward)
2200C28B
// PC+0x2C: addi x12, x5, 0  → x12 = 0xFF3F00FF (saved)
00028613
//
// Test 3: PRELU — MEM/WB forwarding (1 NOP between setter and PRELU)
// PC+0x30: lui  x1, 0x80000  → x1 = 0x80000000
800000B7
// PC+0x34: addi x1, x1, 1   → x1 = 0x80000001  ← forwarded via MEM/WB
00108093
// PC+0x38: nop
00000013
// PC+0x3C: PRELU x5, x1     → x5 = 0x00000001 (MEM/WB forward)
4000D28B
// PC+0x40: addi x13, x5, 0  → x13 = 0x00000001 (saved)
00028693
//
// Test 4: PRELU — EX/MEM forwarding (addi immediately before PRELU)
// PC+0x44: lui  x1, 0xFF7F0  → x1 = 0xFF7F0000
FF7F00B7
// PC+0x48: addi x1, x1, 0xFF → x1 = 0xFF7F00FF  ← forwarded via EX/MEM
0FF08093
// PC+0x4C: PRELU x5, x1     → x5 = 0x007F0000 (EX/MEM forward)
4000D28B
// PC+0x50: addi x14, x5, 0  → x14 = 0x007F0000 (saved)
00028713
//
// Halt: jal x0, 0
// PC+0x54:
0000006F
// padding
